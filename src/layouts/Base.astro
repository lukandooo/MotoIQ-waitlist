---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
}

const {
  title = 'MotoIQ',
  // Długi opis: meta description (SEO), pełne zdanie z Wyceną.
  description = 'MotoIQ zbiera ogłoszenia z Otomoto i sprzedajemy.pl w jednym miejscu, robi wstępną weryfikację każdej oferty i układa je od najbezpieczniejszej. Sprawdź też realną wartość rynkową konkretnego modelu dzięki Wycenie.',
  // Krótki opis: og/twitter (karta). Mieści się w całości na podglądzie linku.
  ogDescription = 'Ogłoszenia z wielu portali w jednym miejscu, wstępnie sprawdzone i ułożone od najbezpieczniejszej oferty.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://motoiq.eu').toString();
const ogImageURL = new URL('/og-image.png', Astro.site ?? 'https://motoiq.eu').toString();

const siteURL = (Astro.site ?? 'https://motoiq.eu').toString().replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteURL}/#organization`,
      name: 'MotoIQ',
      url: `${siteURL}/`,
      email: 'swiecicki.luka@gmail.com',
      description:
        'MotoIQ zbiera ogłoszenia z Otomoto i sprzedajemy.pl w jednym miejscu, robi wstępną weryfikację każdej oferty i układa je od najbezpieczniejszej. Oferuje też Wycenę, która na podstawie prawdziwych cen z ogłoszeń mówi, ile dany model jest realnie wart.',
      image: ogImageURL,
      foundingDate: '2025',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Gdańsk',
        addressCountry: 'PL',
      },
      areaServed: { '@type': 'Country', name: 'Poland' },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}/#website`,
      url: `${siteURL}/`,
      name: 'MotoIQ',
      description:
        'Ogłoszenia samochodów używanych z Otomoto i sprzedajemy.pl w jednym miejscu, wstępnie zweryfikowane i ułożone od najbezpieczniejszej, oraz wycena oparta na prawdziwych cenach z ogłoszeń.',
      publisher: { '@id': `${siteURL}/#organization` },
      inLanguage: 'pl-PL',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteURL}/#software`,
      name: 'MotoIQ',
      url: `${siteURL}/`,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      inLanguage: 'pl-PL',
      description:
        'MotoIQ zbiera ogłoszenia samochodów używanych z Otomoto i sprzedajemy.pl w jednym miejscu, robi wstępną weryfikację każdej oferty (czerwone flagi, podejrzane dane, kompletność informacji) i układa je od najbezpieczniejszej do najsłabszej. Wartość rynkową liczy zaawansowany, autorski algorytm statystyczny.',
      featureList: [
        'Ogłoszenia z wielu portali w jednym miejscu',
        'Wstępna weryfikacja każdej oferty: czerwone flagi, podejrzane dane, kompletność informacji',
        'Lista ofert ułożona od najbezpieczniejszej do najsłabszej',
        'Wartość rynkowa liczona zaawansowanym, autorskim algorytmem statystycznym',
        'Filtry po marce, modelu, nadwoziu, roczniku, przebiegu i cenie',
      ],
      publisher: { '@id': `${siteURL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="MotoIQ" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script src="https://analytics.ahrefs.com/analytics.js" data-key="jNfvx3qUWFvmpCcGS1AmSQ" async></script>

  </head>
  <body>
    <slot />
  </body>
</html>