---
import Base from '../layouts/Base.astro';
import '../styles/landing.css';
---

<Base
  title="MotoIQ"
  description="MotoIQ przeszukuje Otomoto i sprzedajemy.pl, ocenia każde ogłoszenie i zwraca tylko te warte uwagi. Sprawdź też realną wartość konkretnego auta w sekundę dzięki Wycenie."
  ogDescription="MotoIQ przeszukuje Otomoto i sprzedajemy.pl, ocenia każde ogłoszenie i zwraca tylko te warte uwagi."
>
  <main class="page">

    <!-- Top status bar -->
    <header class="topbar">
      <div class="brand">
        <span class="brand-name">MotoIQ</span>
      </div>
      <div class="status mono">
        <span class="status-dot" aria-hidden="true"></span>
        <span>WCZESNY DOSTĘP · PL</span>
        <span class="status-sep">·</span>
        <span class="status-badge" data-default="POLSKI STARTUP" data-hover="POLSKA GUROM!!">POLSKI STARTUP</span>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-meta label">
        <span>/ 01</span>
        <span>WCZESNY DOSTĘP · PL</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
        <span>DACH · SK · UK WKRÓTCE</span>
      </div>

      <h1 class="headline">
        Rynek aut ma<br/>
        więcej <em>danych</em><br/>
        niż <em>czasu</em> na nie.
      </h1>

      <p class="lede">
        Każdego dnia na Otomoto i sprzedajemy.pl pojawiają się tysiące nowych ogłoszeń.
        MotoIQ przegląda je za Ciebie non stop, ocenia każde pod względem
        realnej wartości i zwraca Ci tylko te, które rzeczywiście warto zobaczyć.
        Ty patrzysz na dziesięć najlepszych ofert, nie na wszystkie tysiące.
        Oszczędzasz godziny i masz szansę zareagować pierwszy zanim oferta zniknie.
      </p>
    </section>

    <!-- Value props strip -->
    <ul class="values mono" aria-label="Co dostajesz">
      <li>
        <span class="values-num">01</span>
        <span class="values-text">Powiadomienia o nowych okazjach w sekundy od ich pojawienia się na rynku.</span>
      </li>
      <li>
        <span class="values-num">02</span>
        <span class="values-text">Zaawansowany algorytm wylicza które ogłoszenia są najbardziej opłacalne i tylko te zwraca.</span>
      </li>
      <li>
        <span class="values-num">03</span>
        <span class="values-text">Filtrujesz po marce, budżecie i lokalizacji. Sam narzucasz swoje wymagania, reszta dzieje się automatycznie.</span>
      </li>
    </ul>

    <!-- How it works -->
    <section class="how">
      <div class="how-meta label">
        <span>/ 02</span>
        <span>JAK TO DZIAŁA</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
      </div>

      <!-- Nic laczaca: timeline 01 -> 02 -> 03 nad kartami -->
      <div class="how-flow" aria-hidden="true">
        <div class="how-flow-track"><span class="how-flow-fill"></span></div>
        <span class="how-flow-node n1"></span>
        <span class="how-flow-node n2"></span>
        <span class="how-flow-node n3 live"></span>
      </div>

      <div class="how-grid">
        <div class="how-step">
          <span class="how-step-num">KROK 01</span>
          <h3 class="how-step-title">Twoje wytyczne</h3>
          <p class="how-step-desc">
            Oprócz typowych wytycznych jak marka, model, budżet, lokalizacja, oferujemy niestandardowe wytyczne.
            Od koloru, mocy silnika, po pierwszego właściciela, fakturę VAT, autoryzowanego dealera i więcej.
            Ustawiasz raz, MotoIQ pracuje
            w tle non stop, dzień i noc.
          </p>
          <span class="how-step-time">2 minuty setupu</span>
        </div>

        <div class="how-step">
          <span class="how-step-num">KROK 02</span>
          <h3 class="how-step-title">Zaawansowany, autorski algorytm</h3>
          <p class="how-step-desc">
            Każde ogłoszenie spełniające Twoje kryteria przechodzi przez nasz
            autorski wzór matematyczny, który bierze pod uwagę markę, model,
            rocznik, przebieg i dziesiątki innych zależności jednocześnie.
            Widzisz tylko te oferty, które wypadają najlepiej.
          </p>
          <span class="how-step-time">w czasie rzeczywistym</span>
        </div>

        <div class="how-step">
          <span class="how-step-num">KROK 03</span>
          <h3 class="how-step-title">Powiadomienie w czasie rzeczywistym</h3>
          <p class="how-step-desc">
            Gdy znajdziemy ogłoszenie warte uwagi, które spełnia Twoje wytyczne,
            dostajesz od razu powiadomienie. Działasz pierwszy, zanim ktoś inny
            zdąży zadzwonić.
          </p>
          <span class="how-step-time">przewaga czasowa</span>
        </div>
      </div>

      <!-- Expansion strip -->
      <div class="expansion">
        <span class="expansion-label">ZASIĘG</span>
        <p class="expansion-text">
          Polska to pierwszy rynek. Granica nas nie ogranicza. Integrujemy kolejne
          portale ogłoszeniowe w Europie, a to Ty zdecydujesz które dołączą najpierw.
          Budujemy MotoIQ z myślą o ludziach, więc to społeczność wybiera, jaki
          rynek wskoczy na podium jako następny.
        </p>
        <div class="expansion-markets">
          <span class="market-tag active">PL · sprzedajemy.pl</span>
          <span class="market-tag active">PL · Otomoto</span>
          <span class="market-tag soon">DE · Mobile.de</span>
          <span class="market-tag soon">SE · Blocket</span>
          <span class="market-tag soon">NO · Finn.no</span>
        </div>
      </div>
    </section>

    <!-- Algorytm: wizualny dowod dzialania (wykres cena / przebieg) -->
    <section class="algo" id="algo">
      <div class="algo-meta label">
        <span>/ 03</span>
        <span>ALGORYTM</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
      </div>

      <div class="algo-grid">
        <div class="algo-copy">
          <h2 class="algo-title">
            Tysiące ofert.<br/>
            <em>Jedna linia wartości.</em>
          </h2>
          <p class="algo-desc">
            Algorytm zbiera wszystkie ogłoszenia danego modelu i wylicza realną
            wartość dla każdego przebiegu. Każda kropka to jedno ogłoszenie.
            Te pod krzywą to okazje, które MotoIQ wyłapuje za Ciebie.
          </p>

          <div class="algo-stat">
            <span class="algo-stat-num mono" id="algo-count" data-final="20000">0</span>
            <span class="algo-stat-label label">ofert analizowanych dziennie</span>
          </div>

          <ul class="algo-legend" aria-hidden="true">
            <li><span class="dot-key grey"></span> oferta</li>
            <li><span class="dot-key deal"></span> okazja (pod krzywą)</li>
            <li><span class="dot-key line"></span> wartość godziwa</li>
          </ul>
        </div>

        <div class="algo-chart">
          <svg viewBox="0 0 720 340" width="100%" preserveAspectRatio="xMidYMid meet"
               role="img" aria-label="Wykres średniej ceny auta względem przebiegu z rozrzutem ofert">
            <defs>
              <linearGradient id="algoArea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="rgba(59,130,246,.28)"/>
                <stop offset="1" stop-color="rgba(59,130,246,0)"/>
              </linearGradient>
              <clipPath id="algoClip"><rect id="algoClipRect" x="64" y="0" width="0" height="340"/></clipPath>
            </defs>

            <line class="algo-gridline" x1="64" y1="72"  x2="696" y2="72"/>
            <line class="algo-gridline" x1="64" y1="163" x2="696" y2="163"/>
            <line class="algo-gridline" x1="64" y1="254" x2="696" y2="254"/>

            <g clip-path="url(#algoClip)">
              <path class="algo-area" d="M64,72 L127,108 L190,138 L254,163 L317,189 L380,211 L443,232 L506,251 L570,265 L696,287 L696,300 L64,300 Z"/>
              <path class="algo-line" d="M64,72 L127,108 L190,138 L254,163 L317,189 L380,211 L443,232 L506,251 L570,265 L696,287"/>
            </g>

            <circle class="algo-dot grey" cx="112" cy="92"  r="4"/>
            <circle class="algo-dot grey" cx="150" cy="122" r="4"/>
            <circle class="algo-dot deal" cx="182" cy="158" r="4.5"/>
            <circle class="algo-dot grey" cx="236" cy="150" r="4"/>
            <circle class="algo-dot grey" cx="290" cy="176" r="4"/>
            <circle class="algo-dot deal" cx="322" cy="205" r="4.5"/>
            <circle class="algo-dot grey" cx="360" cy="200" r="4"/>
            <circle class="algo-dot grey" cx="410" cy="222" r="4"/>
            <circle class="algo-dot hot"  cx="440" cy="252" r="6"/>
            <circle class="algo-dot grey" cx="486" cy="243" r="4"/>
            <circle class="algo-dot grey" cx="536" cy="258" r="4"/>
            <circle class="algo-dot deal" cx="584" cy="284" r="4.5"/>
            <circle class="algo-dot grey" cx="636" cy="278" r="4"/>

            <!-- Slabe oferty: szare kropki nad linia (przewartosciowane) -->
            <circle class="algo-dot grey" cx="210" cy="118" r="4"/>
            <circle class="algo-dot grey" cx="350" cy="172" r="4"/>
            <circle class="algo-dot grey" cx="470" cy="212" r="4"/>
            <circle class="algo-dot grey" cx="600" cy="244" r="4"/>

            <text class="algo-axlab" x="64"  y="326">0 km</text>
            <text class="algo-axlab" x="330" y="326">125 000</text>
            <text class="algo-axlab" x="636" y="326">250 000</text>
            <text class="algo-axlab" x="64"  y="60" >cena · pln</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- Marki: TEST sekcja, dwa warianty do porównania -->
    <section class="brands">
      <div class="brands-meta label">
        <span>/ 04</span>
        <span>MARKI W BAZIE</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
      </div>

      <div class="brands-top-grid">
        <div class="brands-copy">
          <h2 class="brands-title">
            Zaczynamy od marek,<br/>
            <em>które dominują wtórny rynek.</em>
          </h2>

          <p class="brands-desc">
            Na start obejmujemy 10 kluczowych marek, które stanowią
            największą część obrotu samochodami używanymi w Polsce.
            Docelowo zamierzamy zintegrować wszystkie najpopularniejsze marki na świecie.
            To użytkownicy będą wybierać, która marka ma się pojawić jako następna.
          </p>
        </div>

        <ul class="brands-name-list" aria-label="Marki w bazie MotoIQ">
          <li class="brand-name-tag">Volkswagen</li>
          <li class="brand-name-tag">Audi</li>
          <li class="brand-name-tag">Ford</li>
          <li class="brand-name-tag">Opel</li>
          <li class="brand-name-tag">BMW</li>
          <li class="brand-name-tag">Mercedes-Benz</li>
          <li class="brand-name-tag">Toyota</li>
          <li class="brand-name-tag">Skoda</li>
          <li class="brand-name-tag">Renault</li>
          <li class="brand-name-tag">Kia</li>
        </ul>
      </div>

      <div class="brands-marquee">
        <div class="brands-marquee-track" id="brands-track">
          <div class="brand-tile-m brand-vw"><img src="/logos/volkswagen-logo.svg" alt="Volkswagen" loading="lazy" /></div>
          <div class="brand-tile-m brand-audi"><img src="/logos/audi-logo.svg" alt="Audi" loading="lazy" /></div>
          <div class="brand-tile-m brand-ford"><img src="/logos/ford-logo.svg" alt="Ford" loading="lazy" /></div>
          <div class="brand-tile-m brand-opel"><img src="/logos/opel-logo.svg" alt="Opel" loading="lazy" /></div>
          <div class="brand-tile-m brand-bmw"><img src="/logos/bmw-logo.svg" alt="BMW" loading="lazy" /></div>
          <div class="brand-tile-m brand-mercedes"><img src="/logos/mercedes-benz-logo.svg" alt="Mercedes-Benz" loading="lazy" /></div>
          <div class="brand-tile-m brand-toyota"><img src="/logos/toyota-logo.svg" alt="Toyota" loading="lazy" /></div>
          <div class="brand-tile-m brand-skoda"><img src="/logos/skoda-logo.svg" alt="Skoda" loading="lazy" /></div>
          <div class="brand-tile-m brand-renault"><img src="/logos/renault-logo.svg" alt="Renault" loading="lazy" /></div>
          <div class="brand-tile-m brand-kia"><img src="/logos/kia-logo.svg" alt="Kia" loading="lazy" /></div>
          <!-- duplikat do płynnej pętli, musi być identyczny z setem powyżej -->
          <div class="brand-tile-m brand-vw" aria-hidden="true"><img src="/logos/volkswagen-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-audi" aria-hidden="true"><img src="/logos/audi-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-ford" aria-hidden="true"><img src="/logos/ford-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-opel" aria-hidden="true"><img src="/logos/opel-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-bmw" aria-hidden="true"><img src="/logos/bmw-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-mercedes" aria-hidden="true"><img src="/logos/mercedes-benz-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-toyota" aria-hidden="true"><img src="/logos/toyota-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-skoda" aria-hidden="true"><img src="/logos/skoda-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-renault" aria-hidden="true"><img src="/logos/renault-logo.svg" alt="" loading="lazy" /></div>
          <div class="brand-tile-m brand-kia" aria-hidden="true"><img src="/logos/kia-logo.svg" alt="" loading="lazy" /></div>
        </div>
      </div>
    </section>

    <!-- Wycena -->
    <section class="wycena" id="wycena">
      <div class="wycena-meta label">
        <span>/ 05</span>
        <span>WYCENA</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
      </div>

      <div class="wycena-grid">
        <div class="wycena-copy">
          <h2 class="wycena-title">
            Zanim zadzwonisz,<br/>
            <em>wiedz ile to warte.</em>
          </h2>
          <p class="wycena-desc">
            Masz konkretny model na oku? Wpisujesz markę, rocznik i przebieg.
            Wycena sprawdza realne ceny transakcyjne na rynku i mówi Ci
            jedną liczbę: ile to auto powinno kosztować.
          </p>
          <p class="wycena-desc">
            Kupujesz, wiesz czy nie przepłacasz. Sprzedajesz, wiesz jaką cenę
            ustawić żeby nie czekać miesiąc i nie oddać auta za grosze.
            Jedna funkcja, dwa zastosowania.
          </p>
          <p class="wycena-desc">
            Razem z wyceną zobaczysz też kilka przykładowych ofert z rynku
            dla tego samego modelu i rocznika, żebyś mógł porównać liczbę
            z realnymi ogłoszeniami, nie tylko zaufać liczbie na ekranie.
          </p>
        </div>

        <div class="wycena-demo" aria-hidden="true">
          <div class="wycena-demo-head">
            <span class="label">Przykład</span>
          </div>
          <div class="wycena-demo-row">
            <span class="wycena-demo-label">Marka</span>
            <span class="wycena-demo-value scramble" data-final="Volkswagen">Volkswagen</span>
          </div>
          <div class="wycena-demo-row">
            <span class="wycena-demo-label">Model</span>
            <span class="wycena-demo-value scramble" data-final="Passat B8">Passat B8</span>
          </div>
          <div class="wycena-demo-row">
            <span class="wycena-demo-label">Rocznik</span>
            <span class="wycena-demo-value scramble" data-final="2019">2019</span>
          </div>
          <div class="wycena-demo-row">
            <span class="wycena-demo-label">Przebieg</span>
            <span class="wycena-demo-value scramble" data-final="112 000 km">112 000 km</span>
          </div>
          <div class="wycena-demo-row">
            <span class="wycena-demo-label">Sprzedawca</span>
            <span class="wycena-demo-value scramble" data-final="Osoba prywatna">Osoba prywatna</span>
          </div>
          <div class="wycena-demo-result">
            <span class="wycena-demo-result-label label">Realny zakres cen</span>
            <span class="wycena-demo-result-value mono"><span id="wyc-lo">0</span> <span class="wycena-demo-sep">do</span> <span id="wyc-hi">0</span> <span class="wycena-demo-currency">PLN</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA section -->
    <section class="cta">
      <div class="cta-meta label">
        <span>/ 06</span>
        <span>WCZESNY DOSTĘP</span>
        <span class="hero-meta-line" aria-hidden="true"></span>
      </div>

      <div class="cta-grid">
        <div class="cta-copy">
          <h2 class="cta-title">
            Bądź pierwszy,<br/>
            <em>kiedy ruszymy.</em>
          </h2>
          <p class="cta-desc">
            Jesteśmy na wczesnym etapie i to działa na Twoją korzyść. Pierwsi
            użytkownicy dostają dostęp najszybciej i mają największy wpływ na to,
            jak MotoIQ ostatecznie wygląda.
            <strong>Bez kart, bez zobowiązań, bez spamu.</strong>
          </p>
          <ul class="cta-bullets mono">
            <li><span class="cta-bullet-dot" aria-hidden="true"></span> Dostęp w dniu startu, bez czekania w kolejce</li>
            <li><span class="cta-bullet-dot" aria-hidden="true"></span> Wczesne ceny promocyjne dla pierwszych użytkowników</li>
            <li><span class="cta-bullet-dot" aria-hidden="true"></span> Jeden mail kiedy produkt będzie gotowy, bez spamu</li>
            <li><span class="cta-bullet-dot" aria-hidden="true"></span> Bezpośredni kontatkt z Founderem;)</li>
          </ul>
        </div>

        <div class="instrument">
          <div class="instrument-head">
            <span class="label">Zapisz się</span>
            <span class="mono ticks" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
            </span>
          </div>

          <form id="waitlist" class="form" novalidate>
            <div class="field">
              <label for="name" class="label">Imię</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="given-name"
                placeholder="Jan"
              />
            </div>

            <div class="field">
              <label for="email" class="label">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="jan@gmail.com"
              />
            </div>

            <div class="field">
              <label for="phone" class="label">Telefon</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="+48 123 456 789"
              />
            </div>

            <!-- honeypot for bots -->
            <div class="hp" aria-hidden="true">
              <label for="company">Firma</label>
              <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="submit">
              <span class="submit-label">Zapisz się</span>
              <span class="submit-arrow" aria-hidden="true">→</span>
            </button>

            <p id="msg" class="msg" role="status" aria-live="polite"></p>

            <p class="legal mono">
              Bez spamu. Bez odsprzedaży listy. Wypisz się jednym kliknięciem.
            </p>
          </form>
        </div>
      </div>
    </section>

    <div class="footnote mono">
      <span>MotoIQ v0.1</span>
      <span>·</span>
      <span>gdańsk · pl</span>
      <span>·</span>
      <span id="year"></span>
      <span class="footnote-sep">·</span>
      <a href="mailto:swiecicki.luka@gmail.com" class="footnote-email">swiecicki.luka@gmail.com</a>
    </div>
  </main>

  <script is:inline>
    // Easter egg: "POLSKI STARTUP" -> "POLSKA GUROM" na hover
    (function () {
      const badge = document.querySelector('.status-badge');
      if (!badge) return;

      const original = badge.dataset.default || badge.textContent;
      const hoverText = badge.dataset.hover;
      if (!hoverText) return;

      badge.addEventListener('mouseenter', () => {
        badge.textContent = hoverText;
      });
      badge.addEventListener('mouseleave', () => {
        badge.textContent = original;
      });
    })();
  </script>

  <script is:inline>
    // Pasek marek: mierzymy realną szerokość jednego zestawu logo (10 marek + gapy)
    // i ustawiamy precyzyjny dystans animacji, żeby pętla zamykała się bez przeskoku.
    (function () {
      const track = document.getElementById('brands-track');
      if (!track) return;

      function setLoopDistance() {
        const tiles = Array.from(track.children);
        const half = tiles.length / 2;
        if (half < 1) return;

        // ostatni kafel pierwszego zestawu
        const lastOfFirstSet = tiles[half - 1];
        const firstTile = tiles[0];

        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        const distance =
          (lastOfFirstSet.offsetLeft + lastOfFirstSet.offsetWidth) -
          firstTile.offsetLeft +
          gap;

        track.style.setProperty('--loop-distance', `${distance}px`);
      }

      // czekamy aż logo (SVG) się wczytają, inaczej offsetWidth bywa 0
      window.addEventListener('load', setLoopDistance);
      setLoopDistance();

      // przelicz też po zmianie rozmiaru okna
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(setLoopDistance, 200);
      });
    })();
  </script>

  <script is:inline>
    document.getElementById('year').textContent = new Date().getFullYear();

    const form = document.getElementById('waitlist');
    const msg = document.getElementById('msg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'msg';

      const data = new FormData(form);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        phone: data.get('phone'),
        company: data.get('company'),
      };

      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true;
      btn.querySelector('.submit-label').textContent = 'Wysyłam…';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json();

        if (!res.ok) throw new Error(json.error || 'Coś poszło nie tak.');

        msg.textContent = '✓ Zapisano. Odezwiemy się jak będziemy gotowi.';
        msg.classList.add('msg-ok');
        form.reset();
      } catch (err) {
        msg.textContent = '✕ ' + (err.message || 'Spróbuj jeszcze raz.');
        msg.classList.add('msg-err');
      } finally {
        btn.disabled = false;
        btn.querySelector('.submit-label').textContent = 'Zapisz się';
      }
    });
  </script>

  <script is:inline>
    // Wykres algorytmu: animacja startuje dopiero gdy sekcja wjezdza w kadr.
    (function () {
      const algo = document.getElementById('algo');
      if (!algo) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Kropki-oferty: opoznienie wg pozycji X — pojawiaja sie w miare jak linia sunie.
      algo.querySelectorAll('.algo-dot').forEach((d) => {
        const cx = parseFloat(d.getAttribute('cx'));
        const delay = Math.round(((cx - 64) / 632) * 1800) + 300;
        d.style.setProperty('--d', delay + 'ms');
      });

      const countEl = document.getElementById('algo-count');
      const FINAL = parseInt(countEl.dataset.final, 10);
      const fmt = (n) => n.toLocaleString('pl-PL');
      function countUp() {
        if (reduce) { countEl.textContent = fmt(FINAL) + '+'; return; }
        const dur = 1600, t0 = performance.now();
        function tick(now) {
          const p = Math.min((now - t0) / dur, 1);
          const e = 1 - Math.pow(1 - p, 3);
          countEl.textContent = fmt(Math.round(FINAL * e));
          if (p < 1) requestAnimationFrame(tick);
          else countEl.textContent = fmt(FINAL) + '+';
        }
        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          algo.classList.add('play');
          countUp();
          io.disconnect();
        });
      }, { threshold: 0.35 });
      io.observe(algo);
    })();
  </script>

  <script is:inline>
    // Sekcja 02: stagger kart + nic laczaca odpalane przy wejsciu w kadr.
    (function () {
      const how = document.querySelector('.how');
      const grid = document.querySelector('.how-grid');
      if (!how || !grid) return;
      how.classList.add('is-armed');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          how.classList.add('play');
          io.disconnect();
        });
      }, { threshold: 0.4 });
      io.observe(grid);
    })();
  </script>

  <script is:inline>
    // Sekcja 06 (CTA): stagger bulletow + ticki jako pasek postepu + blysk sukcesu.
    (function () {
      const cta = document.querySelector('.cta');
      const form = document.getElementById('waitlist');
      const ticksWrap = document.querySelector('.ticks');
      if (!cta || !form || !ticksWrap) return;
      const ticks = Array.from(ticksWrap.querySelectorAll('span'));
      const N = ticks.length;

      // Stagger bulletow przy wejsciu w kadr
      cta.classList.add('is-armed');
      const bullets = cta.querySelector('.cta-bullets') || cta;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          cta.classList.add('play');
          io.disconnect();
        });
      }, { threshold: 0.3 });
      io.observe(bullets);

      // Ticki jako pasek postepu: ile wymaganych pol jest poprawnie wypelnionych
      const required = ['name', 'email', 'phone'];
      let doneState = false;
      function fieldValid(name) {
        const el = form.elements[name];
        if (!el) return false;
        if (el.type === 'email') return el.value.trim() !== '' && el.checkValidity();
        return el.value.trim() !== '';
      }
      function updateProgress() {
        if (doneState) return;
        const count = required.filter(fieldValid).length;
        const lit = Math.round((count / required.length) * N);
        ticks.forEach((t, i) => t.classList.toggle('lit', i < lit));
      }
      form.addEventListener('input', updateProgress);

      // Sukces: wszystkie ticki niebieskie + blysk, potem powrot do stanu ambient
      const msg = document.getElementById('msg');
      if (msg) {
        new MutationObserver(() => {
          if (!msg.classList.contains('msg-ok')) return;
          doneState = true;
          ticks.forEach((t) => t.classList.remove('lit'));
          ticksWrap.classList.add('done', 'flash');
          setTimeout(() => ticksWrap.classList.remove('flash'), 700);
          setTimeout(() => {
            ticksWrap.classList.remove('done');
            doneState = false;
            updateProgress();
          }, 3000);
        }).observe(msg, { attributes: true, attributeFilter: ['class'] });
      }
    })();
  </script>

  <script is:inline>
    // Sekcja 05 (Wycena): count-up ceny przy wejsciu w kadr + scramble wartosci.
    (function () {
      const wyc = document.getElementById('wycena');
      if (!wyc) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lo = document.getElementById('wyc-lo');
      const hi = document.getElementById('wyc-hi');
      const LO = 64900, HI = 71200;
      const fmt = (n) => n.toLocaleString('pl-PL');

      function countUp() {
        const rv = wyc.querySelector('.wycena-demo-result-value');
        if (reduce) { lo.textContent = fmt(LO); hi.textContent = fmt(HI); return; }
        const dur = 1500, t0 = performance.now();
        function tick(now) {
          const p = Math.min((now - t0) / dur, 1);
          const e = 1 - Math.pow(1 - p, 3);
          lo.textContent = fmt(Math.round(LO * e));
          hi.textContent = fmt(Math.round(HI * e));
          if (p < 1) requestAnimationFrame(tick);
          else {
            lo.textContent = fmt(LO);
            hi.textContent = fmt(HI);
            rv.classList.add('lock');
            setTimeout(() => rv.classList.remove('lock'), 900);
          }
        }
        requestAnimationFrame(tick);
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          countUp();
          io.disconnect();
        });
      }, { threshold: 0.3 });
      io.observe(wyc.querySelector('.wycena-demo'));

      // Scramble wartosci specyfikacji na hover
      const CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%@/<>*';
      function scramble(el) {
        const final = el.dataset.final, len = final.length;
        let frame = 0; const steps = 28;
        clearInterval(el._iv);
        el._iv = setInterval(() => {
          let out = '';
          for (let i = 0; i < len; i++) {
            if (final[i] === ' ') { out += ' '; continue; }
            out += (i < (frame / steps) * len) ? final[i] : CH[Math.floor(Math.random() * CH.length)];
          }
          el.textContent = out; frame++;
          if (frame > steps) { clearInterval(el._iv); el.textContent = final; }
        }, 42);
      }
      wyc.querySelectorAll('.scramble').forEach((el) => el.addEventListener('mouseenter', () => scramble(el)));
    })();
  </script>
</Base>